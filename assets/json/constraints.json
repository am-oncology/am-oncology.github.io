{
  "_comment": "Every row carries a source and a status. status='sourced' means the value was transcribed directly from the cited document. status='unverified' means it came from general knowledge and has NOT been checked against the primary source — the UI marks these amber and they must be signed off before clinical use. Change status to 'local' once your centre has ratified a value, and put your own agreed number in.",

  "sources": {
    "uk-sabr-2017": {
      "label": "UK SABR Consortium consensus",
      "citation": "Hanna GG, Murray L, Patel R, et al. UK Consensus on Normal Tissue Dose Constraints for Stereotactic Radiotherapy. Clin Oncol 2018;30(1):5-14.",
      "url": "https://doi.org/10.1016/j.clon.2017.09.007",
      "note": "Constraints are for a first course of SABR to a previously non-irradiated site, SABR alone, no concurrent systemic therapy. Cranial and spinal canal near-max = D0.1cc; all other body sites use D0.5cc. Superseded in part by the 2022 consensus — check before use."
    },
    "uk-sabr-2022": {
      "label": "UK SABR Consortium 2022 consensus",
      "citation": "Diez P, Hanna GG, Aitken KL, et al. UK 2022 Consensus on Normal Tissue Dose-Volume Constraints for Oligometastatic, Primary Lung and Hepatocellular Carcinoma SABR. Clin Oncol 2022;34(5):288-300.",
      "url": "https://pubmed.ncbi.nlm.nih.gov/35272913/",
      "note": "The current consortium document. Values below marked uk-sabr-2017 have not yet been reconciled against this update."
    },
    "quantec": {
      "label": "QUANTEC",
      "citation": "Marks LB, Yorke ED, Jackson A, et al. Use of Normal Tissue Complication Probability Models in the Clinic. Int J Radiat Oncol Biol Phys 2010;76(3 Suppl):S10-19, and organ-specific papers in the same issue.",
      "url": "https://www.redjournal.org/issue/S0360-3016(09)X0027-2",
      "note": "Conventional fractionation, approximately 1.8-2 Gy per fraction, unless stated otherwise."
    },
    "sabr-reirrad-pelvis-2025": {
      "label": "UK pelvic SABR re-irradiation guidance",
      "citation": "UK SABR Consortium. Pelvic SABR reirradiation: UK SABR consortium guidance for use in routine clinical care. Clin Transl Radiat Oncol 2025.",
      "url": "https://www.sciencedirect.com/science/article/pii/S2405632425000277",
      "note": "Covers patient selection, cumulative dose calculation and planning for pelvic re-irradiation. Directly relevant to recurrent rectal disease. Not yet transcribed into this table."
    }
  },

  "groups": [
    {
      "id": "cns-sabr",
      "name": "CNS — SABR and SRS",
      "site": "neuro",
      "type": "sabr",
      "fractions": [1, 3, 5, 8],
      "note": "Near-point maximum for cranial structures and spinal canal is D0.1cc. Single fraction is recommended for CNS metastases; multi-fraction values are for large lesions. Not designed specifically for SRS, though commonly applied. For treatment of the spine itself, apply spinal canal values to the cord PRV.",
      "rows": [
        { "oar": "Optic pathway", "metric": "D0.1cc",
          "limits": { "1": { "mand": 8 }, "3": { "mand": 15 }, "5": { "mand": 22.5 } },
          "endpoint": "Grade 3+ optic neuropathy. Hiniker: ~0.8% risk at 3 fractions, ~1.6% at 5 fractions when limited to 0.05cc.",
          "source": "uk-sabr-2017", "status": "sourced" },

        { "oar": "Cochlea", "metric": "Mean",
          "limits": { "1": { "opt": 4, "mand": 9 }, "3": { "mand": 17.1 }, "5": { "mand": 25 } },
          "endpoint": "Grade 3+ hearing loss. Cochlear volume is small enough that mean may be treated as near-point dose.",
          "source": "uk-sabr-2017", "status": "sourced" },

        { "oar": "Brainstem (excluding medulla)", "metric": "D0.1cc",
          "limits": { "1": { "opt": 10, "mand": 15 }, "3": { "opt": 18, "mand": 23.1 }, "5": { "opt": 23, "mand": 31 } },
          "endpoint": "Grade 3+ cranial neuropathy",
          "source": "uk-sabr-2017", "status": "sourced" },

        { "oar": "Spinal canal (including medulla)", "metric": "D0.1cc",
          "limits": { "1": { "opt": 10, "mand": 14 }, "3": { "opt": 18, "mand": 21.9 }, "5": { "opt": 23, "mand": 30 }, "8": { "opt": 25, "mand": 32 } },
          "endpoint": "Grade 3+ myelitis. Grimm: single and 3-fraction optimal doses to 0.1cc limit grade 2-4 myelopathy risk to ≤0.4%.",
          "source": "uk-sabr-2017", "status": "sourced" },

        { "oar": "Spinal canal (including medulla)", "metric": "D1cc",
          "limits": { "1": { "opt": 7 }, "3": { "opt": 12.3 }, "5": { "opt": 14.5 } },
          "endpoint": "Grade 3+ myelitis",
          "source": "uk-sabr-2017", "status": "sourced" },

        { "oar": "Cauda equina and sacral plexus", "metric": "D0.1cc",
          "limits": { "1": { "mand": 16 }, "3": { "mand": 24 }, "5": { "mand": 32 } },
          "endpoint": "Grade 3+ neuritis",
          "source": "uk-sabr-2017", "status": "sourced" },

        { "oar": "Cauda equina and sacral plexus", "metric": "D5cc",
          "limits": { "1": { "mand": 14 }, "3": { "mand": 22 }, "5": { "mand": 30 } },
          "endpoint": "Grade 3+ neuritis",
          "source": "uk-sabr-2017", "status": "sourced" },

        { "oar": "Normal brain", "metric": "D10cc",
          "limits": { "1": { "opt": 12 } },
          "endpoint": "Radiation necrosis (group consensus, not trial-derived)",
          "source": "uk-sabr-2017", "status": "sourced" },

        { "oar": "Whole brain minus GTV", "metric": "D50%",
          "limits": { "1": { "opt": 5 } },
          "endpoint": "Cognitive deterioration (group consensus)",
          "source": "uk-sabr-2017", "status": "sourced" },

        { "oar": "Lens", "metric": "D0.1cc",
          "limits": { "1": { "opt": 1.5 } },
          "endpoint": "Cataract formation (group consensus). Keep as low as reasonably practicable.",
          "source": "uk-sabr-2017", "status": "sourced" },

        { "oar": "Orbit (surrogate for retina)", "metric": "D0.1cc",
          "limits": { "1": { "opt": 8 } },
          "endpoint": "Retinopathy (group consensus). Keep as low as reasonably practicable.",
          "source": "uk-sabr-2017", "status": "sourced" }
      ]
    },

